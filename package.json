{
	"name": "react-navix",
	"version": "0.1.0",
	"description": "A lightweight, zero-dependency React router — nested routes, navigation blocking, scroll restoration, error boundaries, and full TypeScript support",
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"README_ES.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings",
		"check": "biome check",
		"check:fix": "biome check --write",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^30.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"react",
		"router",
		"routing",
		"browserrouter",
		"hashrouter",
		"react-navix",
		"navix"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dapize/react-navix.git"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"author": "dapize",
	"bugs": {
		"url": "https://github.com/dapize/react-navix/issues"
	},
	"homepage": "https://github.com/dapize/react-navix#readme"
}
